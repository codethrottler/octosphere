# Copy to .env and adjust for your machine. Never commit the real .env.

DJANGO_SECRET_KEY=change-me-to-a-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=octosphere
DB_USER=octosphere
DB_PASSWORD=octosphere_dev_pw
DB_HOST=localhost
DB_PORT=3306

CORS_ALLOWED_ORIGINS=http://localhost:5173

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
